#!/data/data/com.termux/files/usr/bin/bash
# dns53-aaaa — 一键切换 dns53 的 AAAA 屏蔽
# 用法: dns53-aaaa on|off|status
set -euo pipefail

DNS_DIR="${XDG_DATA_HOME:-$HOME/.local/share}/dns53"
D53="$DNS_DIR/dns53.js"
LOG="$DNS_DIR/logs/dns53.log"
mkdir -p "$DNS_DIR/logs"

[ -f "$DNS_DIR/root.sh" ] || { echo "缺少 $DNS_DIR/root.sh, 请重跑 dns53 安装器" >&2; exit 1; }
# shellcheck source=root.sh
. "$DNS_DIR/root.sh"
dns53_load_root_mode 0

get_pid() {
  dns53_root_exec pgrep -f '^node .*dns5[3]\.js' 2>/dev/null | head -1 || true
}

show_status() {
  local pid mode
  pid=$(get_pid)
  if [ -z "$pid" ]; then
    echo "dns53 未运行"
    return
  fi
  mode=$(dns53_root_exec cat "/proc/$pid/environ" 2>/dev/null | tr '\0' '\n' | sed -n 's/^DNS53_DISABLE_AAAA=//p' || true)
  if [ "$mode" = "0" ]; then
    echo "关闭（放行 AAAA/IPv6）| PID $pid"
  else
    echo "开启（屏蔽 AAAA，只走 IPv4）| PID $pid"
  fi
}

restart() {
  local val="$1" label="$2"
  if ! dns53_have_root; then
    echo "当前无 root (模式: ${ROOT_MODE:-none}), 无法重启 dns53" >&2
    return 1
  fi
  dns53_root_exec pkill -f '^node .*dns5[3]\.js' 2>/dev/null || true
  sleep 1
  dns53_root_exec env DNS53_DISABLE_AAAA="$val" nohup node "$D53" > "$LOG" 2>&1 &
  sleep 1
  echo "✓ $label"
  show_status
}

case "${1:-status}" in
  on)  restart 1 "AAAA 屏蔽已开启（默认，只走 IPv4）" ;;
  off) restart 0 "AAAA 屏蔽已关闭（放行 IPv6）" ;;
  status) show_status ;;
  *) echo "用法: dns53-aaaa on|off|status" >&2; exit 1 ;;
esac
